{
  "expo": {
    "name": "Blur Face",
    "slug": "blur-face",
    "version": "2.4.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blurface.app"
    },
    "android": {
      "package": "com.blurface.app",
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withLargeScreenSupport",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1318"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Blur Face needs access to your photos to save and manage your edited photos.",
          "savePhotosPermission": "Blur Face needs permission to save your edited photos.",
          "granularPermissions": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a9e1ad3e-57bd-435b-b45a-a1e4de781544"
      }
    }
  }
}
